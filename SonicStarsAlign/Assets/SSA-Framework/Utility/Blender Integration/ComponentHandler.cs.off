using UnityEngine;
using SSA.ExtraData;

public class ComponentHandler : MonoBehaviour
{
    private ExtraData extraData;
    private int objectType;
    void Awake()
    {
        extraData = GetComponentInChildren<ExtraData>();
        if (!extraData.extrasData.TryGetValue("obj_type", out objectType))
        {
            return;
        }
        switch(objectType)
        {
            case 0:
                {
                    // Spawnpoint
                    
                    break;
                }
        }
    }
}
